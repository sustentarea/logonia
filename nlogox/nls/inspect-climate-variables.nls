; globals [
;   inspect-tmin
;   inspect-tmax
;   inspect-prec
; ]

to inspect-climate-variables
  if (inspect-var? = true) [
    ask logonias [hide-turtle]

    let #color 0
    let #var 0

    (ifelse (inspection-var = "Average Minimum Temperature (°C)") [
      set #color lime
      set #var "tmin"
    ] (inspection-var = "Average Maximum Temperature (°C)") [
      set #color 42.7
      set #var "tmax"
    ] (inspection-var = "Total Precipitation (mm)") [
      set #color brown
      set #var "prec"
    ])

    let #value [runresult #var] of patches with [not is-false? (runresult #var)]
    let #min-pcolor-value min #value
    let #max-pcolor-value max #value

    ask (patches) [
      ifelse (not is-false? (runresult #var)) [
        set pcolor (
          scale-color
            #color
            (runresult #var)
            #min-pcolor-value
            #max-pcolor-value
      )
      ] [
        set pcolor gray + 4
      ]
    ]
  ]
end
